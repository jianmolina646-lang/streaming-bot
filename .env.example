# Token del bot, obtenido de @BotFather en Telegram
BOT_TOKEN=123456:ABC-DEF...

# IDs de Telegram de los administradores (separados por coma).
# Para conocer tu ID puedes escribirle a @userinfobot.
ADMIN_IDS=123456789,987654321

# Nombre de tu tienda (aparece en los mensajes del bot)
SHOP_NAME=Mi Tienda Streaming

# Moneda mostrada en los precios
CURRENCY=USD

# Texto con tus métodos de pago (soporta Markdown de Telegram).
# Se muestra al cliente cuando confirma un pedido.
PAYMENT_INSTRUCTIONS="*Métodos de pago disponibles:*\n\n💳 PayPal: tu_correo@ejemplo.com\n🏦 Transferencia: 0000-0000-0000-0000 (Banco XYZ)\n₿ Binance Pay ID: 123456789\n\nEnvía el comprobante por aquí mismo y te activamos la cuenta."

# Ruta de la base de datos SQLite
DATABASE_URL=sqlite:///shop.db

# Umbrales de gasto acumulado (en tu moneda) para promover automáticamente
# a un cliente a VIP 1 (5% off) y VIP 2 (10% off). Si pones 0, se desactiva ese nivel.
VIP_THRESHOLD_1=100
VIP_THRESHOLD_2=300

# Emojis personalizados opcionales de Telegram Premium.
# Obtén los IDs respondiendo /emojiid a un mensaje que contenga el emoji.
# Si se dejan vacíos, el bot usa emojis Unicode normales.
PREMIUM_EMOJI_SUCCESS_ID=
PREMIUM_EMOJI_KEY_ID=
PREMIUM_EMOJI_WARNING_ID=
PREMIUM_EMOJI_STAR_ID=
# Clave Fernet exclusiva para cifrar PIN y datos temporales del agente.
# Genera una con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AGENT_ENCRYPTION_KEY=
AGENT_API_TOKEN=
AGENT_API_HOST=127.0.0.1
AGENT_API_PORT=8092
# Mail Control se configura en el agente Windows, no en el proceso del bot.
